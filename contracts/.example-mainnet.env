# Mainnet
ETHEREUM_CHAIN_ID=1

# Endpoint definitions (used by foundry.toml rpc_endpoints)
MAINNET_RPC_URL=https://.....

# Mainnet forbids MOCK_AZTEC=true (default false if omitted)
MOCK_AZTEC=false

# Optional override (default is 172800)
TIMELOCK_DURATION=172800

# Required on Mainnet
LZ_ENDPOINT=0x1a44076050125825900e736c501f859c50fE728c

# Required on Mainnet
ASSET=0x0000000000000000000000000000000000000000
ROLLUP_REGISTRY=0x0000000000000000000000000000000000000000
GOVERNANCE=0x0000000000000000000000000000000000000000
TREASURY=0x0000000000000000000000000000000000000000
PROVIDER_ADMIN=0x0000000000000000000000000000000000000000
GUARDIAN=0x0000000000000000000000000000000000000000

# Required for live deploys
PRIVATE_KEY=<hex>

# Enforced two-step flow flags in Deploy.s.sol
# 1) dry-run: DEPLOY_STEP=dry-run
# 2) broadcast: DEPLOY_STEP=broadcast + flags below
DEPLOY_STEP=dry-run
DEPLOY_DRY_RUN_DONE=false
DEPLOY_WITH_VERIFY=false
