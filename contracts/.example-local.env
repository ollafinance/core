# Local (Anvil)
ETHEREUM_CHAIN_ID=31337

# Local defaults
MOCK_AZTEC=true
TIMELOCK_DURATION=0

# Optional: only used when MOCK_AZTEC=false
# ASSET=0x0000000000000000000000000000000000000000
# ROLLUP_REGISTRY=0x0000000000000000000000000000000000000000

# Optional local operator-flow flags (strictly enforced only on Sepolia/Mainnet)
DEPLOY_STEP=broadcast
DEPLOY_DRY_RUN_DONE=true
DEPLOY_WITH_VERIFY=true

# Optional: defaults to Anvil account-0 key when chainid == 31337
# PRIVATE_KEY=<hex-without-0x>
