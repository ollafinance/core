# Sepolia
ETHEREUM_CHAIN_ID=11155111

# Endpoint definitions (used by foundry.toml rpc_endpoints)
SEPOLIA_RPC_URL=https://....

# Required by Testnet.s.sol: must be explicitly set
MOCK_AZTEC=false

# Timelock duration in seconds
TIMELOCK_DURATION=259200

# Required on Sepolia (definition required; may be zero)
LZ_ENDPOINT=0x6EDCE65403992e310A62460808c4b910D972f10f

# Required when MOCK_AZTEC=false
# latest info here: https://docs.aztec.network/networks
ASSET=0x5595cb9ed193cac2c0bc5393313bc6115817954b
ROLLUP_REGISTRY=0xa0bfb1b494fb49041e5c6e8c2c1be09cd171c6ba

# Protocol defaults
PROTOCOL_FEE_BP=500
TREASURY_FEE_SPLIT_BP=5000

# SafetyModule defaults
SAFETY_DEPOSIT_CAP=1000000000000000000000000000 # 1,000,000,000 AZTEC
SAFETY_MIN_RATE_DROP_BPS=500 # 5%
SAFETY_MAX_QUEUE_RATIO_BPS=5000 # 50%
SAFETY_MAX_ACCOUNTING_DELAY=172800 # 2 days

# Recommended role addresses (defaults to deployer if unset)
GOVERNANCE=0xaAd484fBb75DA44af07975D845ADD9515b65a55B
TREASURY=0x90e7b822a5Ac10edC381aBc03d94b866e4B985A1
PROVIDER_ADMIN=0xeFB5C5e06b5d4b78838fe8186931AaD104898a9A
PROVIDER_REWARDS_RECIPIENT=0x90e7b822a5Ac10edC381aBc03d94b866e4B985A1
GUARDIAN=0xaAd484fBb75DA44af07975D845ADD9515b65a55B # same as governance

# Required for live deploys
PRIVATE_KEY=<hex>

# Enforced two-step flow flags in Deploy.s.sol
# 1) dry-run: DEPLOY_STEP=dry-run
# 2) broadcast: DEPLOY_STEP=broadcast + flags below
DEPLOY_STEP=dry-run
DEPLOY_DRY_RUN_DONE=false
DEPLOY_WITH_VERIFY=false
