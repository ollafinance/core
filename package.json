{
  "name": "olla-core",
  "private": true,
  "devDependencies": {
    "husky": "8.0.3",
    "solhint": "6.0.2"
  },
  "packageManager": "yarn@4.12.0",
  "scripts": {
    "postinstall": "husky install",
    "lint": "solhint --config contracts/.solhint.json \"contracts/src/**/*.sol\"",
    "lint:fix": "solhint --config contracts/.solhint.json --fix --noPrompt \"contracts/src/**/*.sol\""
  }
}
