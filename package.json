{
  "name": "olla-core",
  "private": true,
  "devDependencies": {
    "husky": "8.0.3",
    "solhint": "6.0.2",
    "solhint-plugin-explicit-return": "portal:./solhint-rules",
    "typescript": "5.4.5"
  },
  "packageManager": "yarn@4.12.0",
  "scripts": {
    "postinstall": "husky install",
    "solhint:build": "tsc -p solhint-rules/tsconfig.json",
    "lint": "yarn solhint:build && cd contracts && solhint --config .solhint.json \"src/**/*.sol\"",
    "lint:fix": "yarn solhint:build && cd contracts && solhint --config .solhint.json --fix --noPrompt \"src/**/*.sol\""
  }
}
