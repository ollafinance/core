{
  "name": "olla-core",
  "private": true,
  "devDependencies": {
    "husky": "8.0.3",
    "solhint": "6.0.2"
  },
  "packageManager": "yarn@4.12.0",
  "scripts": {
    "postinstall": "husky install",
    "lint": "cd contracts && solhint --config .solhint.json \"src/**/*.sol\"",
    "lint:fix": "cd contracts && solhint --config .solhint.json --fix --noPrompt \"src/**/*.sol\""
  }
}