{
  "name": "olla-core",
  "private": true,
  "devDependencies": {
    "@types/node": "20.11.30",
    "husky": "8.0.3",
    "solhint": "6.0.2",
    "solhint-plugin-explicit-return": "portal:./solhint-rules",
    "typescript": "5.4.5"
  },
  "packageManager": "yarn@4.12.0",
  "scripts": {
    "postinstall": "husky install",
    "solhint:build": "tsc -p solhint-rules/tsconfig.json",
    "lint": "cd contracts && solhint --config .solhint.json \"src/**/*.sol\"",
    "lint:fix": "cd contracts && solhint --config .solhint.json --fix --noPrompt \"src/**/*.sol\"",
    "slither": "cd contracts && slither . --config-file slither.config.json",
    "test": "yarn test:unit && yarn test:invariant && yarn test:integration",
    "test:unit": "cd contracts && forge test --match-path \"test/**/*.t.sol\" --no-match-path \"test/**/*.integration.sol\"",
    "test:invariant": "cd contracts && forge test --match-path \"test/**/*.invariant.sol\"",
    "test:integration": "cd contracts && forge test --match-path \"test/**/*.integration.sol\"",
    "dev:anvil": "anvil",
    "dev:deploy": "cd contracts && forge script script/Deploy.s.sol --broadcast --rpc-url http://127.0.0.1:8545 --private-key 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"
  }
}
