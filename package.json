{
  "name": "olla-core",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@types/node": "20.11.30",
    "husky": "8.0.3",
    "solhint": "6.0.2",
    "solhint-plugin-explicit-return": "portal:./solhint-rules",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "viem": "^2.44.4"
  },
  "packageManager": "yarn@4.12.0",
  "scripts": {
    "forge:build": "cd contracts && forge build",
    "forge:build:tiny-memory": "cd contracts && bash -lc 'shopt -s globstar nullglob; for f in src/**/*.sol script/**/*.sol; do echo \"Building: $f\"; forge build \"$f\"; done'",
    "forge:build-all": "cd contracts && forge build --force --threads 0",
    "forge:fmt": "cd contracts && forge fmt && forge fmt script/",
    "postinstall": "husky install",
    "solhint:build": "tsc -p solhint-rules/tsconfig.json",
    "lint": "cd contracts && solhint --config .solhint.json \"src/**/*.sol\" && solhint --config script/.solhint.json \"script/**/*.sol\"",
    "lint:fix": "cd contracts && solhint --config .solhint.json --fix --noPrompt \"src/**/*.sol\" && solhint --config script/.solhint.json --fix --noPrompt \"script/**/*.sol\"",
    "slither": "cd contracts && slither . --config-file slither.config.json",
    "slither:docker": "docker build -f contracts/Dockerfile.slither -t olla-slither:local . && docker run --rm -v \"$PWD/contracts:/work\" -w /work olla-slither:local slither . --config-file slither.config.json",
    "test": "yarn test:unit && yarn test:invariant && yarn test:integration && yarn test:interface-compat",
    "test:unit": "cd contracts && forge test --match-path \"test/**/*.t.sol\" --no-match-path \"test/**/*.{integration,invariant}.t.sol\"",
    "test:invariant": "cd contracts && forge test --match-path \"test/**/*.invariant.t.sol\"",
    "test:integration": "cd contracts && forge test --match-path \"test/**/*.integration.t.sol\"",
    "test:e2e": "cd contracts && forge test --match-path \"test/e2e/*.e2e.t.sol\" -vvv",
    "test:interface-compat": "cd contracts && forge test --match-path \"test/integration/AztecInterfaceCompatibility.integration.t.sol\"",
    "dev:chain": "anvil --order fifo",
    "dev:build": "cd contracts && FOUNDRY_PROFILE=dev forge build --force --threads 0",
    "deploy:local": "env -i PATH=\"$PATH\" HOME=\"$HOME\" bash -lc 'set -a; . ./contracts/.example-local.env; set +a; forge script ./contracts/script/Deploy.s.sol:DeployScript --root ./contracts --broadcast --rpc-url http://127.0.0.1:8545'",
    "dev:mock-loop": "tsx mock-loop/index.ts",
    "dev:mock-loop:once": "tsx mock-loop/index.ts --once",
    "dev:mock-loop:until-error": "tsx mock-loop/index.ts --until-error",
    "dev:mock-loop:permissionless": "tsx mock-loop/index.ts --until-error --config ./config-permissionless.ts",
    "dev:mock-loop:demo": "tsx mock-loop/index.ts --config ./demo-config.ts"
  }
}
