#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

if find contracts/src contracts/test contracts/script -type f -name "*.sol" -print -quit | grep -q .; then
  echo "Running forge fmt before commit..."
  (cd contracts && forge fmt)
  echo "Running solhint before commit..."
  yarn lint:fix
  echo "Running unit tests before commit..."
  yarn test:unit
  echo "Running invariant tests before commit..."
  yarn test:invariant
else
  echo "No Solidity files found; skipping forge fmt, solhint, and tests."
fi
