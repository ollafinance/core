#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "Running forge fmt before commit..."
(cd contracts && forge fmt)
echo "Running solhint before commit..."
yarn lint:fix
echo "Running slither before commit..."
yarn slither
echo "Running unit tests before commit..."
yarn test:unit
echo "Running invariant tests before commit..."
yarn test:invariant
